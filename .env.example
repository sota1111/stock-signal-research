APP_ENV=local
GCP_PROJECT_ID=your-project-id
AUTH_USERNAME=admin
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-auth-password)
AUTH_PASSWORD=changeme
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-auth-secret-key)
AUTH_SECRET_KEY=your-secret-key-change-this-in-production
GCP_REGION=asia-northeast1
FIRESTORE_DATABASE=(default)
USE_SAMPLE_DATA=true
JOB_NAME=collect-papers
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-semantic-scholar-api-key)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-news-api-key)
NEWS_API_KEY=your-news-api-key
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-llm-api-key)
LLM_API_KEY=your-llm-api-key
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-app-admin-token)
APP_ADMIN_TOKEN=your-admin-token
LOG_LEVEL=INFO

# Optional or other variables
DATABASE_URL=sqlite:///./data/app.db
PORT=8080
VITE_API_URL=http://localhost:8080

# ===================================
# Cloud Run / Artifact Registry デプロイ設定
# ===================================
CLOUD_RUN_SERVICE_NAME=stock-signal-service
ARTIFACT_REGISTRY_REPOSITORY=stock-signal-registry
IMAGE_NAME=stock-signal-research-app
