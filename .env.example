APP_ENV=local
GCP_PROJECT_ID=your-project-id
# ===================================
# Firebase Authentication設定（案1: サーバサイドREST認証）
# ===================================
# ブラウザはFirebaseと直接通信しない。サーバが Identity Toolkit REST
# (accounts:signInWithPassword) でメール/パスワードを照合する。
# Firebase Console > プロジェクト設定 > アプリ から Web API key を取得。
# Cloud Run本番環境ではSecret Manager管理。
# FIREBASE_WEB_API_KEY が優先され、未設定時は FIREBASE_API_KEY にフォールバックする（どちらか一方でログイン可）。
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# 許可するメールアドレス（カンマ区切り、空の場合は全ユーザー許可）
# Cloud Run本番環境ではSecret Manager管理推奨
ALLOWED_USER_EMAILS=your-email@example.com

# セッションcookie署名用シークレット（32文字以上推奨）
# Cloud Run本番環境ではSecret Manager管理
AUTH_SECRET=your-random-secret-key-here

# Firebase Admin SDK uses GOOGLE_CLOUD_PROJECT (same value as GCP_PROJECT_ID)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=asia-northeast1
# 本番環境 Firestore DB名 (production 専用)
FIRESTORE_DATABASE=(default)
USE_SAMPLE_DATA=true
JOB_NAME=collect-papers
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-semantic-scholar-api-key)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-news-api-key)
NEWS_API_KEY=your-news-api-key
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-llm-api-key)
LLM_API_KEY=your-llm-api-key
# Cloud Run本番環境ではSecret Manager管理 (secret name: stock-signal-app-admin-token)
APP_ADMIN_TOKEN=your-admin-token
LOG_LEVEL=INFO

# Optional or other variables
# ローカル開発専用 (APP_ENV=local)
DATABASE_URL=sqlite:///./data/app.db
PORT=8080
VITE_API_URL=http://localhost:8080

# ===================================
# Cloud Run / Artifact Registry デプロイ設定
# ===================================
# 正式 Cloud Run サービス名（旧 stock-signal-service は廃止予定）
CLOUD_RUN_SERVICE_NAME=stock-signal-research
ARTIFACT_REGISTRY_REPOSITORY=stock-signal-registry
IMAGE_NAME=stock-signal-research-app
